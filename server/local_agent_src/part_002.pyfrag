)))
    return _json_result({"name": meta.get("name") or base.name, "scope": scope, "description": meta.get("description", ""), "path": str(base), "skill_md": text, "truncated": truncated, "inventory": inv})


def _validate_git_url(url, allow_non_github=False):
    parsed = urlparse(str(url or ""))
    if parsed.scheme != "https" or not parsed.netloc:
        raise ValueError("Skill review currently requires an https Git URL")
    if parsed.username or parsed.password or parsed.query or parsed.fragment:
        raise ValueError("Skill Git URLs must not embed credentials, query strings, or fragments")
    host = (parsed.hostname or "").lower()
    if host not in {"github.com", "www.github.com"} and not allow_non_github:
        raise PermissionError("Automatic skill review defaults to GitHub HTTPS URLs. Set allow_non_github=true only for a user-approved repository host.")
    return str(url)


def _run_git(args, cwd=None, timeout=120):
    if not shutil.which("git"):
        raise RuntimeError("git is required for skill review/install")
    cp = subprocess.run(["git"] + list(args), cwd=str(cwd) if cwd else None, text=True, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, timeout=timeout, errors="replace")
    if cp.returncode != 0:
        raise RuntimeError(cp.stdout[-12000:] or f"git exited with {cp.returncode}")
    return cp.stdout


def tool_skill_review_git(args):
    url = _validate_git_url(args.get("url"), bool(args.get("allow_non_github", False)))
    ref = str(args.get("ref") or "").strip()
    subdir = str(args.get("subdir") or "").strip().replace("\\", "/").strip("/")
    token = uuid.uuid4().hex[:16]
    review_dir = SKILL_REVIEW_HOME / token
    repo_dir = review_dir / "repo"
    review_dir.mkdir(parents=True, exist_ok=False)
    clone_args = ["clone", "--depth", "1", "--filter=blob:none", "--no-checkout"]
    if ref:
        clone_args += ["--branch", ref]
    clone_args += ["--", url, str(repo_dir)]
    try:
        _run_git(clone_args, timeout=180)
        commit = _run_git(["rev-parse", "HEAD"], cwd=repo_dir).strip()
        tree = _run_git(["ls-tree", "-r", "--name-only", "HEAD"], cwd=repo_dir, timeout=60).splitlines()
        all_candidates = [x for x in tree if x == "SKILL.md" or x.endswith("/SKILL.md")]
        if subdir:
            wanted = f"{subdir}/SKILL.md" if subdir else "SKILL.md"
            candidates = [wanted] if wanted in all_candidates else []
        else:
            candidates = all_candidates
        if len(candidates) != 1:
            rels = [str(Path(c).parent).replace(".", "", 1).lstrip("/") or "." for c in candidates[:100]]
            meta = {"token": token, "url": url, "ref": ref or None, "commit": commit, "candidates": rels, "candidate_count": len(candidates), "ready": False}
            (review_dir / "review.json").write_text(json.dumps(meta, indent=2), encoding="utf-8")
            return _json_result(meta)
        skill_rel = Path(candidates[0]).parent.as_posix()
        if skill_rel == ".":
            _run_git(["checkout", "--detach", "HEAD"], cwd=repo_dir, timeout=120)
            selected = repo_dir
        else:
            _run_git(["sparse-checkout", "init", "--cone"], cwd=repo_dir, timeout=60)
            _run_git(["sparse-checkout", "set", "--", skill_rel], cwd=repo_dir, timeout=60)
            _run_git(["checkout", "--detach", "HEAD"], cwd=repo_dir, timeout=120)
            selected = _norm(repo_dir / skill_rel)
        skill_md = selected / "SKILL.md"
        if not skill_md.is_file():
            raise RuntimeError("Sparse checkout completed but SKILL.md is missing")
        text = skill_md.read_text(encoding="utf-8", errors="replace")
        front = _read_skill_frontmatter(text)
        audit = _skill_inventory(selected)
        digest = hashlib.sha256()
        for item in audit["files"]:
            fp = selected / item["path"]
            digest.update(item["path"].encode("utf-8")); digest.update(b"\0"); digest.update(fp.read_bytes()); digest.update(b"\0")
        meta = {
            "token": token, "url": url, "ref": ref or None, "commit": commit,
            "selected_subdir": "" if selected == repo_dir else str(selected.relative_to(repo_dir)),
            "name": front.get("name") or selected.name,
            "description": front.get("description", ""),
            "sha256": digest.hexdigest(), "audit": audit, "ready": True,
            "skill_md_preview": text[:20000],
        }
        (review_dir / "review.json").write_text(json.dumps(meta, indent=2, ensure_ascii=False), encoding="utf-8")
        return _json_result(meta)
    except Exception:
        shutil.rmtree(review_dir, ignore_errors=True)
        raise


def tool_skill_review_select(args):
    token = str(args.get("review_token") or "").strip()
    subdir = str(args.get("subdir") or "").strip().replace("\\", "/").strip("/")
    review_dir = SKILL_REVIEW_HOME / token
    meta_path = review_dir / "review.json"
    if not meta_path.exists():
        raise FileNotFoundError("Unknown or expired skill review token")
    meta = json.loads(meta_path.read_text(encoding="utf-8"))
    repo_dir = review_dir / "repo"
    candidate_set = set(meta.get("candidates") or [])
    normalized = subdir or "."
    if candidate_set and normalized not in candidate_set:
        raise ValueError("subdir must be one of the candidates returned by skill_review_git")
    if normalized == ".":
        _run_git(["sparse-checkout", "disable"], cwd=repo_dir, timeout=60)
        _run_git(["checkout", "--detach", "HEAD"], cwd=repo_dir, timeout=120)
        selected = repo_dir
    else:
        _run_git(["sparse-checkout", "init", "--cone"], cwd=repo_dir, timeout=60)
        _run_git(["sparse-checkout", "set", "--", subdir], cwd=repo_dir, timeout=60)
        _run_git(["checkout", "--detach", "HEAD"], cwd=repo_dir, timeout=120)
        selected = _norm(repo_dir / subdir)
    if not _is_within(selected, repo_dir) or not selected.is_dir() or not (selected / "SKILL.md").is_file():
        raise ValueError("Selected subdir must contain SKILL.md inside the reviewed repository")
    text = (selected / "SKILL.md").read_text(encoding="utf-8", errors="replace")
    front = _read_skill_frontmatter(text)
    audit = _skill_inventory(selected)
    digest = hashlib.sha256()
    for item in audit["files"]:
        fp = selected / item["path"]
        digest.update(item["path"].encode("utf-8")); digest.update(b"\0"); digest.update(fp.read_bytes()); digest.update(b"\0")
    meta.update({"selected_subdir": "" if selected == repo_dir else str(selected.relative_to(repo_dir)), "name": front.get("name") or selected.name, "description": front.get("description", ""), "sha256": digest.hexdigest(), "audit": audit, "ready": True, "skill_md_preview": text[:20000]})
    meta_path.write_text(json.dumps(meta, indent=2, ensure_ascii=False), encoding="utf-8")
    return _json_result(meta)


def tool_skill_install_reviewed(args):
    token = str(args.get("review_token") or "").strip()
    scope = str(args.get("scope") or "global").lower()
    if scope not in {"global", "workspace"}:
        raise ValueError("scope must be global or workspace")
    review_dir = SKILL_REVIEW_HOME / token
    meta_path = review_dir / "review.json"
    if not meta_path.exists():
        raise FileNotFoundError("Unknown or expired skill review token")
    meta = json.loads(meta_path.read_text(encoding="utf-8"))
    if not meta.get("ready") or not meta.get("selected_subdir"):
        raise ValueError("Review is not ready; select one candidate first")
    source = _norm(review_dir / "repo" / meta["selected_subdir"])
    if not _is_within(source, review_dir / "repo") or not (source / "SKILL.md").is_file():
        raise ValueError("Reviewed skill source is missing or invalid")
    audit = _skill_inventory(source)
    if audit["binaries"] and not bool(args.get("allow_binaries", False)):
        raise PermissionError("Reviewed skill contains binary files. Re-run only if the user explicitly approves installing those binaries, with allow_binaries=true.")
    name = _safe_skill_name(args.get("name") or meta.get("name") or source.name)
    root = SKILL_HOME if scope == "global" else (WORKSPACE / ".local-hands" / "skills")
    root.mkdir(parents=True, exist_ok=True)
    dest = root / name
    overwrite = bool(args.get("overwrite", False))
    if dest.exists() and not overwrite:
        raise FileExistsError(f"Skill already exists: {dest}. Use overwrite=true only when replacement is intended.")
    if dest.exists():
        shutil.rmtree(dest)
    shutil.copytree(source, dest)
    provenance = {k: meta.get(k) for k in ("url", "ref", "commit", "selected_subdir", "sha256")}
    provenance.update({"installed_at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()), "scope": scope, "name": name})
    (dest / ".local-hands-provenance.json").write_text(json.dumps(provenance, indent=2), encoding="utf-8")
    if bool(args.get("discard_review", True)):
        shutil.rmtree(review_dir, ignore_errors=True)
    return _json_result({"installed": True, "name": name, "scope": scope, "path": str(dest), "provenance": provenance, "audit": audit, "review_discarded": bool(args.get("discard_review", True))})


def tool_skill_review_discard(args):
    token = str(args.get("review_token") or "").strip()
    review_dir = SKILL_REVIEW_HOME / token
    if review_dir.exists():
        shutil.rmtree(review_dir)
    return _json_result({"discarded": token})


def tool_resume_context(args):
    git = None
    try:
        cwd = WORKSPACE
        if shutil.which("git"):
            cp = subprocess.run(["git", "status", "--short", "--branch"], cwd=str(cwd), text=True, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, timeout=10, errors="replace")
            git = {"exit_code": cp.returncode, "output": cp.stdout[-20000:]}
    except Exception as e:
        git = {"error": str(e)}
    skills = []
    try:
        for scope, root in _skill_roots():
            for skill_md in root.glob("*/SKILL.md"):
                skills.append({"name": _read_skill_frontmatter(skill_md.read_text(encoding="utf-8", errors="replace")).get("name") or skill_md.parent.name, "scope": scope})
    except Exception:
        pass
    procs = []
    with PROCESS_LOCK:
        for sid, st in PROCESSES.items():
            procs.append({"session_id": sid, "running": st.poll() is None, "exit_code": st.poll(), "command": st.command, "cwd": st.cwd})
    terms = []
    with TERMINAL_LOCK:
        for tid, st in TERMINALS.items():
            terms.append({"terminal_id": tid, "running": st.poll() is None, "exit_code": st.poll(), "command": st.command, "cwd": st.cwd})
    return _json_result({
        "workspace": str(WORKSPACE), "task": (STATE.get("projects", {}).get(_project_key(), {}).get("task") or STATE.get("task", {})),
        "project_context": {k: v for k, v in STATE.get("projects", {}).get(_project_key(), {}).items() if k != "task"},
        "recent_workspaces": STATE.get("recent_workspaces", []),
        "git": git, "processes": procs, "terminals": terms, "skills": skills,
    })


def tool_list_directory(args):
    p = _resolve_path(args.get("path", "."), must_exist=True, want_dir=True)
    recursive = bool(args.get("recursive", False))
    max_entries = max(1, min(int(args.get("max_entries", 500)), 10_000))
    entries = []
    iterable = p.rglob("*") if recursive else p.iterdir()
    for child in iterable:
        try:
            rel = child.relative_to(WORKSPACE) if _is_within(child, WORKSPACE) else child
            kind = "dir" if child.is_dir() else "file" if child.is_file() else "other"
            size = child.stat().st_size if child.is_file() else None
            entries.append({"path": str(rel), "type": kind, "size": size})
        except OSError:
            continue
        if len(entries) >= max_entries:
            break
    entries.sort(key=lambda x: (x["type"] != "dir", x["path"].lower()))
    return _json_result({"base": str(p), "entries": entries, "truncated": len(entries) >= max_entries})


def tool_find_files(args):
    base = _resolve_path(args.get("path", "."), must_exist=True, want_dir=True)
    pattern = str(args.get("pattern") or "*")
    max_results = max(1, min(int(args.get("max_results", 500)), 5000))
    include_dirs = bool(args.get("include_dirs", False))
    out = []
    for child in base.rglob("*"):
        try:
            if child.is_dir() and not include_dirs:
                continue
            rel = child.relative_to(base)
            if fnmatch.fnmatch(str(rel), pattern) or fnmatch.fnmatch(child.name, pattern):
                out.append({"path": str(child.relative_to(WORKSPACE)) if _is_within(child, WORKSPACE) else str(child), "type": "dir" if child.is_dir() else "file"})
                if len(out) >= max_results:
                    break
        except (OSError, ValueError):
            continue
    return _json_result({"base": str(base), "pattern": pattern, "results": out, "truncated": len(out) >= max_results})


def tool_read_text(args):
    p = _resolve_path(args.get("path", ""), must_exist=True, want_dir=False)
    max_bytes = max(1, min(int(args.get("max_bytes", 262144)), 2_097_152))
    data = p.read_bytes()
    original_bytes = len(data)
    truncated_bytes = original_bytes > max_bytes
    if truncated_bytes:
        data = data[:max_bytes]
    text = data.decode(args.get("encoding", "utf-8"), errors="replace")
    lines = text.splitlines()
    start = max(1, int(args.get("start_line", 1)))
    default_end = min(len(lines), start + 1999)
    end = int(args.get("end_line", default_end)) if lines else 0
    end = max(start - 1, min(end, len(lines)))
    chosen = lines[start - 1:end]
    numbered = "\n".join(f"{i}: {line}" for i, line in enumerate(chosen, start=start))
    header = f"{p} | lines={len(lines)} | bytes={original_bytes} | shown={start}-{end}"
    if truncated_bytes:
        header += " | byte-truncated=true"
    return _text_result(header + ("\n" + numbered if numbered else ""))


def _atomic_write_text(p: Path, content: str, encoding="utf-8"):
    p.parent.mkdir(parents=True, exist_ok=True)
    fd, tmp_name = tempfile.mkstemp(prefix=p.name + ".", suffix=".tmp", dir=str(p.parent))
    try:
        with os.fdopen(fd, "w", encoding=encoding, newline="") as fh:
            fh.write(content)
        os.replace(tmp_name, p)
    except Exception:
        try:
            os.unlink(tmp_name)
        except OSError:
            pass
        raise


def tool_write_text(args):
    p = _resolve_path(args.get("path", ""), must_exist=False)
    content = args.get("content", "")
    create_parents = bool(args.get("create_parents", False))
    if create_parents:
        p.parent.mkdir(parents=True, exist_ok=True)
    elif not p.parent.exists():
        raise FileNotFoundError(f"Pa